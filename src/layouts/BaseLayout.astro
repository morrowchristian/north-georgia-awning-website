---
export interface Props {
  title: string;
  description?: string;
}
const { title, description = "Professional awnings & shades serving North Georgia" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | North Georgia Awning</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" />
  <slot name="head" />
</head>
<body class="min-h-screen flex flex-col">
  <slot />
</body>
</html>