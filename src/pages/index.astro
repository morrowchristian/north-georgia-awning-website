---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Home">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary to-blue-900 text-white py-32">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-5xl md:text-7xl font-bold mb-6">Protect What Matters Most</h1>
      <p class="text-2xl md:text-3xl mb-10 opacity-90">Retractable Awnings • Patio Shades • Pergolas</p>
      <a href="/quote" class="inline-block bg-accent hover:bg-orange-700 text-white font-bold text-2xl py-6 px-12 rounded-lg transition transform hover:scale-105">
        Get Your Free Quote Today
      </a>
      <p class="mt-8 text-xl">Most quotes returned same day • No obligation</p>
    </div>
  </section>

  <!-- Trust Section -->
  <section class="py-20 bg-gray-50 text-center">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="bg-white p-8 rounded-xl shadow-lg">
          <h3 class="text-2xl font-bold text-primary mb-4">Lifetime Warranty</h3>
          <p class="text-gray-600">Industry-leading coverage on all installations</p>
        </div>
        <div class="bg-white p-8 rounded-xl shadow-lg">
          <h3 class="text-2xl font-bold text-primary mb-4">Family Owned</h3>
          <p class="text-gray-600">Serving North Georgia with pride since 2010</p>
        </div>
        <div class="bg-white p-8 rounded-xl shadow-lg">
          <h3 class="text-2xl font-bold text-primary mb-4">Free Quotes</h3>
          <p class="text-gray-600">No pressure • Same-day estimates</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>