---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Home">
  <header class="bg-primary text-white py-24 text-center">
    <div class="max-w-5xl mx-auto px-6">
      <h1 class="text-5xl md:text-7xl font-bold mb-6">North Georgia Awning</h1>
      <p class="text-2xl md:text-3xl mb-10">Family-Owned • Lifetime Warranties • Free Quotes</p>
      <a href="/quote" class="inline-block bg-accent hover:bg-orange-700 text-white font-bold text-xl py-5 px-10 rounded-lg transition">
        Get Your Free Quote
      </a>
    </div>
  </header>

  <section class="py-20 text-center bg-gray-50">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-4xl font-bold mb-8">Site is live and Tailwind is working!</h2>
      <p class="text-lg text-gray-600">Start replacing this with Sarah’s real content whenever you're ready.</p>
    </div>
  </section>
</BaseLayout>